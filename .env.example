# Copy to .env on YOUR Windows machine. Never upload/share .env.
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=SmartAttendanceLocal
SQLSERVER_USER=attendance_app
SQLSERVER_PASSWORD=REPLACE_WITH_YOUR_SQL_PASSWORD
# Local self-signed SQL Server certificate only; do not use for remote production.
SQLSERVER_TRUST_CERTIFICATE=true
APP_URL=http://localhost:5173
# Separate Clerk development application for this local edition.
# Do not edit/export the Replit-managed instance's secrets.
CLERK_PUBLISHABLE_KEY=REPLACE_LOCAL_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_LOCAL_CLERK_SECRET_KEY
# Your verified email in the LOCAL Clerk app, not a shared/default password.
SCHOOL_BOOTSTRAP_ADMIN_EMAIL=REPLACE_YOUR_VERIFIED_EMAIL
